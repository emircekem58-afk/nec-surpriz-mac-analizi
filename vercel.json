{
  "version": 2,
  "functions": {
    "api/*.js": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/", "destination": "/v7.html" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {"key": "Cache-Control", "value": "no-store, max-age=0"}
      ]
    }
  ],
  "crons": [
    {"path":"/api/morning","schedule":"0 6 * * *"}
  ]
}
